# Disable Directory Browsing
Options -Indexes

# Protect Sensitive Configuration, Environment & Database Files
<FilesMatch "^\.env|\.git|\.sql|\.log|\.flag">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect Storage & Backup Directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>
