# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=luggage_storage

# Used only to create the first administrator on a new, empty database.
# Set a unique password of at least 12 characters, then remove these lines after setup.
INIT_ADMIN_USER=your_admin_username
INIT_ADMIN_PASSWORD=your_unique_12_character_password

# Hospitality Business Settings
DAILY_PENALTY_FEE=5.00
GRACE_HOURS=2

# Backup Configuration (0 = disabled, 1 = enabled)
AUTO_BACKUP=0
